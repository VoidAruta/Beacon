{
  "name": "beacon-server",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "(test -f hub/static/index.html || vite build --outDir hub/static --emptyOutDir) && BEACON_PREVIEW_MODE=1 python3 -m beacon --port 3000",
    "start": "BEACON_PREVIEW_MODE=1 python3 -m beacon --port 3000",
    "build": "vite build --outDir hub/static --emptyOutDir",
    "build:static": "vite build --outDir hub/static --emptyOutDir",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/hubLogic.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

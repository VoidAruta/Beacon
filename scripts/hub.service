[Unit]
Description=Hub Control Panel (Lightweight Operations Console & Containerless PaaS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/app/applet
Environment="HUB_DIR=/app/applet"
Environment="HUB_PORT=8050"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m hub
Restart=always
RestartSec=3
KillMode=process
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
